# Required: the delivery address Grab scopes all results to.
# From food.grab.com, set your address, then read latitude/longitude
# out of the `location` cookie.
FOOD_LAT=9.11
FOOD_LNG=69.420
FOOD_ADDRESS="Jl. Garuda No. 69, Kecamatan, Kota"
FOOD_COUNTRY=ID

# Optional: only if Chromium is somewhere non-standard.
# CHROME_PATH=/usr/bin/chromium

# Optional: route GoFood (only) through a proxy. Needed on a VPS, where
# GoFood's WAF blocks datacenter IPs. Must exit in Indonesia; Cloudflare
# WARP exits Singapore and is blocked too.
# FOOD_PROXY=socks5://127.0.0.1:40000

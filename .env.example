# Required: the delivery address Grab scopes all results to.
# From food.grab.com, set your address, then read latitude/longitude
# out of the `location` cookie.
FOOD_LAT=-6.175392
FOOD_LNG=106.827153
FOOD_ADDRESS="Monas, Gambir, Jakarta Pusat"
FOOD_COUNTRY=ID

# Optional: only if Chromium is somewhere non-standard.
# CHROME_PATH=/usr/bin/chromium
